// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  shops        Shop[]
  listings     Listing[]
  orders       Order[]
  categories   Category[]
  reviews      Review[]
  favorites    Favorite[]
  activityLogs ActivityLog[]
  coupons      Coupon[]

  @@index([slug])
}

enum UserRole {
  TENANT_ADMIN
  SELLER
  BUYER
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         UserRole @default(BUYER)
  profileJson  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownedShops   Shop[]
  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]
  activityLogs ActivityLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

model Shop {
  id          String     @id @default(cuid())
  tenantId    String
  ownerUserId String
  name        String
  description String?
  status      ShopStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  listings    Listing[]
  payouts     Payout[]
  stats       ShopStats?

  @@index([tenantId])
  @@index([ownerUserId])
  @@index([status])
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLD_OUT
}

model Listing {
  id             String        @id @default(cuid())
  tenantId       String
  shopId         String
  title          String
  description    String?
  status         ListingStatus @default(DRAFT)
  price          Int // in cents
  currency       String        @default("usd")
  stockQty       Int?
  attributesJson Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  categories     ListingCategory[]
  reviews        Review[]
  favorites      Favorite[]

  @@index([tenantId])
  @@index([shopId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  tenantId          String
  buyerId           String
  totalPrice        Int // in cents
  currency          String      @default("usd")
  status            OrderStatus @default(PENDING)
  paymentProvider   String?
  paymentIntentId   String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyer             User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  reviews           Review[]

  @@index([tenantId])
  @@index([buyerId])
  @@index([status])
  @@index([paymentIntentId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  listingId String
  quantity  Int
  unitPrice Int // in cents
  metaJson  Json?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([listingId])
}

enum PayoutStatus {
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
}

model Payout {
  id          String       @id @default(cuid())
  shopId      String
  amount      Int // in cents
  currency    String       @default("usd")
  status      PayoutStatus @default(SCHEDULED)
  scheduledAt DateTime
  executedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([scheduledAt])
}

// Simple cart management (optional - could also be in-memory/Redis)
model CartItem {
  id        String   @id @default(cuid())
  sessionId String // could be user ID or anonymous session
  tenantId  String
  listingId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, listingId])
  @@index([sessionId])
  @@index([tenantId])
}

// Categories for organizing listings
model Category {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  parentId    String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  listings    ListingCategory[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
  @@index([isActive])
}

// Many-to-many relationship between Listings and Categories
model ListingCategory {
  id         String   @id @default(cuid())
  listingId  String
  categoryId String
  createdAt  DateTime @default(now())

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([listingId, categoryId])
  @@index([listingId])
  @@index([categoryId])
}

// Reviews for listings
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  tenantId   String
  listingId  String
  orderId    String?
  userId     String
  rating     Int // 1-5
  title      String?
  comment    String?
  status     ReviewStatus @default(PENDING)
  isVerified Boolean      @default(false) // verified purchase
  helpfulCount Int        @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([listingId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Favorites/Wishlist
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([tenantId])
  @@index([listingId])
}

// Activity logs for audit trail
enum ActivityType {
  USER_REGISTERED
  USER_LOGGED_IN
  SHOP_CREATED
  SHOP_UPDATED
  SHOP_STATUS_CHANGED
  LISTING_CREATED
  LISTING_UPDATED
  LISTING_STATUS_CHANGED
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REVIEW_CREATED
  REVIEW_MODERATED
}

model ActivityLog {
  id          String       @id @default(cuid())
  tenantId    String
  userId      String?
  activityType ActivityType
  entityType  String // 'shop', 'listing', 'order', etc.
  entityId    String
  metadata    Json? // additional context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([activityType])
  @@index([createdAt])
}

// Shop analytics/statistics
model ShopStats {
  id              String   @id @default(cuid())
  shopId          String   @unique
  totalOrders     Int      @default(0)
  totalRevenue    Int      @default(0) // in cents
  totalListings   Int      @default(0)
  activeListings  Int      @default(0)
  averageRating   Float    @default(0)
  totalReviews    Int      @default(0)
  updatedAt       DateTime @updatedAt

  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

// Promotional codes/coupons
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id              String       @id @default(cuid())
  tenantId        String
  code            String
  description     String?
  discountType    DiscountType
  discountValue   Int // percentage or cents
  minPurchase     Int? // minimum purchase in cents
  maxDiscount     Int? // maximum discount in cents
  usageLimit      Int? // null = unlimited
  usageCount      Int          @default(0)
  validFrom       DateTime
  validUntil      DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([isActive])
  @@index([validFrom, validUntil])
}
