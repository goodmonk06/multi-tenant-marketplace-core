// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  shops     Shop[]
  listings  Listing[]
  orders    Order[]

  @@index([slug])
}

enum UserRole {
  TENANT_ADMIN
  SELLER
  BUYER
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         UserRole @default(BUYER)
  profileJson  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownedShops   Shop[]
  orders       Order[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

model Shop {
  id          String     @id @default(cuid())
  tenantId    String
  ownerUserId String
  name        String
  description String?
  status      ShopStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  listings    Listing[]
  payouts     Payout[]

  @@index([tenantId])
  @@index([ownerUserId])
  @@index([status])
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLD_OUT
}

model Listing {
  id             String        @id @default(cuid())
  tenantId       String
  shopId         String
  title          String
  description    String?
  status         ListingStatus @default(DRAFT)
  price          Int // in cents
  currency       String        @default("usd")
  stockQty       Int?
  attributesJson Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@index([tenantId])
  @@index([shopId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  tenantId          String
  buyerId           String
  totalPrice        Int // in cents
  currency          String      @default("usd")
  status            OrderStatus @default(PENDING)
  paymentProvider   String?
  paymentIntentId   String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyer             User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items             OrderItem[]

  @@index([tenantId])
  @@index([buyerId])
  @@index([status])
  @@index([paymentIntentId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  listingId String
  quantity  Int
  unitPrice Int // in cents
  metaJson  Json?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([listingId])
}

enum PayoutStatus {
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
}

model Payout {
  id          String       @id @default(cuid())
  shopId      String
  amount      Int // in cents
  currency    String       @default("usd")
  status      PayoutStatus @default(SCHEDULED)
  scheduledAt DateTime
  executedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([scheduledAt])
}

// Simple cart management (optional - could also be in-memory/Redis)
model CartItem {
  id        String   @id @default(cuid())
  sessionId String // could be user ID or anonymous session
  tenantId  String
  listingId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, listingId])
  @@index([sessionId])
  @@index([tenantId])
}
